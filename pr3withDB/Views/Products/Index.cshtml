@model pr3withDB.Models.ViewModels.CatalogViewModel
@using System.IO
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment WebHostEnvironment

@{
    ViewData["Title"] = "Каталог товаров - Hayastan Shop";
}

<div class="container mt-4">
    <div class="text-center mb-4">
        <h1 class="display-5">Армянский Дворик</h1>
        <p class="text-muted italic">Традиционные армянские товары и деликатесы из сердца Еревана</p>
        <div class="ornament-divider"></div>
    </div>

    <!-- Search, Filters and Sorting Form -->
    <div class="container-parchment mb-5">
        <form method="get" class="row g-3 align-items-center">
            <div class="col-lg-4 col-md-6">
                <label class="form-label fw-bold text-muted small">Поиск товаров</label>
                <input type="text" name="searchString" value="@Model.SearchString" class="form-control form-armenian" placeholder="Поиск по названию или описанию...">
            </div>
            <div class="col-lg-3 col-md-6">
                <label class="form-label fw-bold text-muted small">Категория</label>
                <select name="categoryId" class="form-select form-armenian">
                    <option value="">Все категории</option>
                    @foreach (var cat in Model.Categories)
                    {
                        if (Model.CategoryId == cat.IdCategories)
                        {
                            <option value="@cat.IdCategories" selected>@cat.CategoryName</option>
                        }
                        else
                        {
                            <option value="@cat.IdCategories">@cat.CategoryName</option>
                        }
                    }
                </select>
            </div>
            <div class="col-lg-3 col-md-6">
                <label class="form-label fw-bold text-muted small">Сортировка</label>
                <select name="sortBy" class="form-select form-armenian">
                    @if (Model.SortBy == "name_asc" || string.IsNullOrEmpty(Model.SortBy)) { <option value="name_asc" selected>Название (А-Я)</option> } else { <option value="name_asc">Название (А-Я)</option> }
                    @if (Model.SortBy == "name_desc") { <option value="name_desc" selected>Название (Я-А)</option> } else { <option value="name_desc">Название (Я-А)</option> }
                    @if (Model.SortBy == "price_asc") { <option value="price_asc" selected>Цена (по возрастанию)</option> } else { <option value="price_asc">Цена (по возрастанию)</option> }
                    @if (Model.SortBy == "price_desc") { <option value="price_desc" selected>Цена (по убыванию)</option> } else { <option value="price_desc">Цена (по убыванию)</option> }
                </select>
            </div>
            <div class="col-lg-2 col-md-6 mt-lg-4 pt-lg-2">
                <button type="submit" class="btn btn-armenian w-100 py-2">Применить</button>
            </div>
        </form>
    </div>

    <!-- Product Catalog Cards Grid -->
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var item in Model.Products)
        {
            var fullPath = System.IO.Path.Combine(WebHostEnvironment.WebRootPath, "images", item.ImagePath ?? "");
            var fileExists = !string.IsNullOrEmpty(item.ImagePath) && System.IO.File.Exists(fullPath);
            var verifiedImagePath = fileExists ? item.ImagePath : "placeholder.jpg";
            var displayItem = new { ImagePath = verifiedImagePath };

            <div class="col">
                <div class="card h-100 card-armenian">
                    <div style="overflow: hidden; height: 220px; position: relative; background-color: #f5f5f5;">
                        <img src="~/images/@displayItem.ImagePath" 
                             class="card-img-top w-100 h-100" 
                             alt="@item.Name"
                             style="object-fit: cover;"
                             asp-append-version="true" />
                    </div>
                    <div class="card-body d-flex flex-column p-4">
                        <div class="mb-2">
                            <span class="badge badge-category">@item.CategoryName</span>
                        </div>
                        <h5 class="card-title text-truncate">@item.Name</h5>
                        <p class="card-text mb-4" style="font-size: 0.92rem; min-height: 48px;">
                            @(item.Description?.Length > 90 ? item.Description.Substring(0, 90) + "..." : item.Description)
                        </p>
                        <div class="mt-auto d-flex justify-content-between align-items-center">
                            <div>
                                <span class="d-block text-muted small">Цена</span>
                                <span class="price-text">@item.Price.ToString("C")</span>
                            </div>
                            @if (item.StockQuantity > 0)
                            {
                                <a asp-controller="Cart" asp-action="AddToCart" asp-route-productId="@item.Id" class="btn btn-armenian d-flex align-items-center">
                                    <span class="me-1">🛒</span> Купить
                                </a>
                            }
                            else
                            {
                                <button class="btn btn-secondary btn-sm" disabled>Нет в наличии</button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Beautiful Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="ornament-divider"></div>
        <nav aria-label="Page navigation" class="mt-4 mb-5">
            <ul class="pagination justify-content-center">
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.Page ? "active" : "")">
                        <a class="page-link shadow-none" 
                           style="@(i == Model.Page ? "background-color: var(--color-terracotta); border-color: var(--color-terracotta); color: white;" : "color: var(--color-terracotta); background-color: white; border-color: var(--color-border);")"
                           href="@Url.Action("Index", new { page = i, searchString = Model.SearchString, categoryId = Model.CategoryId, sortBy = Model.SortBy })">
                            @i
                        </a>
                    </li>
                }
            </ul>
        </nav>
    }
    else
    {
        <div class="mb-5"></div>
    }
</div>