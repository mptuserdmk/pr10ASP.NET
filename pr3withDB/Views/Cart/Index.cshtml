@model pr3withDB.Models.ViewModels.CartViewModel
@using System.IO
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment WebHostEnvironment

@{
    ViewData["Title"] = "Ваша корзина - Hayastan Shop";
}

<div class="container mt-5">
    <div class="container-parchment p-5">
        <div class="text-center mb-4">
            <h2 class="display-6" style="color: var(--color-garnet);">Ваша Корзина</h2>
            <p class="text-muted small">Список выбранных вами шедевров армянских мастеров</p>
            <div class="ornament-divider"></div>
        </div>

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger mb-4 shadow-sm" style="border-radius: 8px;">
                <strong>Ошибка:</strong> @TempData["Error"]
            </div>
        }

        @if (!Model.Items.Any())
        {
            <div class="text-center py-5">
                <div class="mb-4" style="font-size: 4rem; opacity: 0.35;">🛒</div>
                <h4 class="text-muted">Ваша корзина пуста</h4>
                <p class="text-muted mb-4">Выберите традиционные товары в нашем каталоге</p>
                <a asp-controller="Products" asp-action="Index" class="btn btn-armenian px-4 py-2">Перейти в каталог</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle table-armenian">
                    <thead>
                        <tr>
                            <th scope="col" style="min-width: 250px;">Товар</th>
                            <th scope="col">Цена</th>
                            <th scope="col" style="width: 140px;">Кол-во</th>
                            <th scope="col" class="text-end">Итого</th>
                            <th scope="col" class="text-center">Действие</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            var fullPath = System.IO.Path.Combine(WebHostEnvironment.WebRootPath, "images", item.ImagePath ?? "");
                            var fileExists = !string.IsNullOrEmpty(item.ImagePath) && System.IO.File.Exists(fullPath);
                            var verifiedImagePath = fileExists ? item.ImagePath : "placeholder.jpg";
                            var displayItem = new { ImagePath = verifiedImagePath };

                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <img src="~/images/@displayItem.ImagePath" 
                                             alt="@item.ProductName" 
                                             style="width: 60px; height: 60px; object-fit: cover; border-radius: 8px; border: 1.5px solid var(--color-border);" 
                                             class="me-3 shadow-sm">
                                        <div>
                                            <span class="fw-bold d-block" style="color: var(--color-garnet); font-size: 1.05rem;">@item.ProductName</span>
                                        </div>
                                    </div>
                                </td>
                                <td class="fw-semibold">@item.ProductPrice.ToString("C")</td>
                                <td>
                                    <form asp-action="UpdateQuantity" method="post" class="d-flex align-items-center">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <input type="number" name="quantity" value="@item.Quantity"
                                               min="1" max="1000" class="form-control form-control-sm form-armenian text-center fw-bold" 
                                               style="width: 65px;" onchange="this.form.submit()" />
                                    </form>
                                </td>
                                <td class="text-end fw-bold price-text" style="color: var(--color-terracotta); font-size: 1.15rem;">
                                    @((item.ProductPrice * item.Quantity).ToString("C"))
                                </td>
                                <td class="text-center">
                                    <a asp-action="RemoveFromCart" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger px-3 py-1" style="border-radius: 6px;">
                                        Удалить
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            
            <div class="ornament-divider"></div>

            <div class="row align-items-center justify-content-between mt-4">
                <div class="col-md-6 mb-3 mb-md-0">
                    <a asp-controller="Products" asp-action="Index" class="btn btn-apricot px-4 py-2">
                        ← Вернуться в каталог
                    </a>
                </div>
                <div class="col-md-6 text-end">
                    <div class="pe-2">
                        <h4 class="mb-3" style="font-family: var(--font-headers);">
                            Общая стоимость: 
                            <span class="price-text ms-2" style="font-size: 1.8rem; color: var(--color-garnet);">@Model.TotalSum.ToString("C")</span>
                        </h4>
                        <form asp-controller="Cart" asp-action="Checkout" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-armenian btn-lg px-5 py-3 w-100 w-md-auto shadow-sm">
                                🌟 Оформить заказ 🌟
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
</div>