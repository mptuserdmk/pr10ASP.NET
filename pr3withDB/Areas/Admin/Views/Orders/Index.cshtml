@model IEnumerable<pr3withDB.Models.Order>
@{
    Layout = "_AdminLayout";
}

<h2>Управление заказами</h2>
<p><a asp-action="Create" class="btn btn-success">Создать заказ</a></p>

<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Пользователь</th>
            <th>Дата</th>
            <th>Сумма</th>
            <th>Статус</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.IdOrders</td>
                <td>@(item.User?.UserLogin ?? "—")</td>
                <td>@item.OrderDate.ToString("dd.MM.yyyy HH:mm")</td>
                <td>@item.OrderTotalAmount.ToString("N2") ₽</td>
                <td>
                    @if (item.OrderStatus == "Pending")
                    {
                        <span class="badge bg-warning text-dark">Ожидает</span>
                    }
                    else if (item.OrderStatus == "Completed")
                    {
                        <span class="badge bg-success">Выполнен</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">@item.OrderStatus</span>
                    }
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.IdOrders" class="btn btn-sm btn-info">Детали</a>
                    <a asp-action="Edit" asp-route-id="@item.IdOrders" class="btn btn-sm btn-primary">Изменить</a>
                    <form asp-action="Delete" asp-route-id="@item.IdOrders" method="post" style="display:inline;">
                        <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Удалить заказ и все его позиции?')">Удалить</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
