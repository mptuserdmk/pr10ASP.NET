@model pr3withDB.Models.Product
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Добавить товар";
}

<h2>Добавить товар</h2>
<hr />
<div class="row">
    <div class="col-md-7">
        <form asp-action="Create" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="All" class="text-danger mb-3 font-weight-bold"></div>
            <div class="form-group mb-3">
                <label asp-for="ProductName" class="form-label">Название</label>
                <input asp-for="ProductName" class="form-control" />
                <span asp-validation-for="ProductName" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="ProductDescription" class="form-label">Описание</label>
                <textarea asp-for="ProductDescription" class="form-control" rows="3"></textarea>
                <span asp-validation-for="ProductDescription" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="ProductPrice" class="form-label">Цена</label>
                <input asp-for="ProductPrice" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="ProductPrice" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="ProductStockQuantity" class="form-label">Количество на складе</label>
                <input asp-for="ProductStockQuantity" class="form-control" type="number" />
                <span asp-validation-for="ProductStockQuantity" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="CategoryId" class="form-label">Категория</label>
                <select asp-for="CategoryId" asp-items="ViewBag.CategoryId" class="form-select">
                    <option value="">-- Выберите категорию --</option>
                </select>
                <span asp-validation-for="CategoryId" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="ImageFile" class="form-label">Изображение товара</label>
                <input asp-for="ImageFile" class="form-control" type="file" accept=".jpg,.jpeg,.png,.webp,.gif" />
                <div class="form-text text-secondary">Допустимые форматы: JPG, JPEG, PNG, WEBP, GIF. Максимум 2 МБ.</div>
                <span asp-validation-for="ImageFile" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-success">Создать</button>
            <a asp-action="Index" class="btn btn-secondary">Отмена</a>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
