@model IEnumerable<pr3withDB.Models.Category>
@{
    Layout = "_AdminLayout";
}

<h2>Управление категориями</h2>
<p><a asp-action="Create" class="btn btn-success">Добавить категорию</a></p>

<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Название</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.IdCategories</td>
                <td>@item.CategoryName</td>
                <td>
                    <a href="/Admin/Categories/Edit/@item.IdCategories" class="col-btn btn btn-sm btn-primary">Изменить</a>

                    <form action="/Admin/Categories/Delete/@item.IdCategories" method="post" style="display:inline;">
                        <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Удалить категорию?')">
                            Удалить
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>