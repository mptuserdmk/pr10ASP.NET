@model pr3withDB.Models.User
@{
    Layout = "_AdminLayout";
}

<h2>Изменение пользователя</h2>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit" method="post">
            <div asp-validation-summary="All" class="text-danger"></div>
            <input type="hidden" asp-for="IdUsers" />
            <div class="form-group mb-3">
                <label asp-for="UserLogin" class="form-label">Логин</label>
                <input asp-for="UserLogin" class="form-control" />
                <span asp-validation-for="UserLogin" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="RoleId" class="form-label">Роль</label>
                <select asp-for="RoleId" asp-items="ViewBag.RoleId" class="form-select">
                    <option value="">-- Выберите роль --</option>
                </select>
            </div>
            <button type="submit" class="btn btn-primary">Сохранить</button>
            <a asp-action="Index" class="btn btn-secondary">Отмена</a>
        </form>
    </div>
</div>
