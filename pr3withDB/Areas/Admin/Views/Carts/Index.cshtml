@model IEnumerable<pr3withDB.Models.Cart>
@{
    Layout = "_AdminLayout";
}

<h2>Управление корзинами</h2>
<p><a asp-action="Create" class="btn btn-success">Создать корзину</a></p>

<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Пользователь</th>
            <th>Дата создания</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.IdCarts</td>
                <td>@(item.User?.UserLogin ?? "—")</td>
                <td>@item.CartCreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.IdCarts" class="btn btn-sm btn-info">Детали</a>
                    <form asp-action="Delete" asp-route-id="@item.IdCarts" method="post" style="display:inline;">
                        <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Удалить корзину и все её товары?')">Удалить</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
