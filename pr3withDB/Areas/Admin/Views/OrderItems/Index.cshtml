@model IEnumerable<pr3withDB.Models.OrderItem>
@{
    Layout = "_AdminLayout";
}

<h2>Позиции заказов</h2>
<p><a asp-action="Create" class="btn btn-success">Добавить позицию</a></p>

<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Заказ №</th>
            <th>Товар</th>
            <th>Количество</th>
            <th>Цена при покупке</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.IdOrderItems</td>
                <td>@item.OrderId</td>
                <td>@(item.Product?.ProductName ?? "—")</td>
                <td>@item.OrderItemQuantity</td>
                <td>@item.OrderItemPriceAtPurchase.ToString("N2") ₽</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.IdOrderItems" class="btn btn-sm btn-primary">Изменить</a>
                    <form asp-action="Delete" asp-route-id="@item.IdOrderItems" method="post" style="display:inline;">
                        <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Удалить позицию?')">Удалить</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
